import java.util.Scanner;

public class MultiplicacaoMatriz {
    public static void main(String[] args) {
        try (Scanner scanner = new Scanner(System.in)) {
            int[][] A = new int[2][4];
            int[][] B = new int[4][2];
            int[][] C = new int[2][2];
            
            System.out.println("Digite os valores para a Matriz A (2x4):");
            for (int i = 0; i < 2; i++) {
                for (int j = 0; j < 4; j++) {
                    System.out.print("Elemento A[" + i + "][" + j + "]: ");
                    A[i][j] = scanner.nextInt();
                }
            }
            
            System.out.println("\nDigite os valores para a Matriz B (4x2):");
            for (int i = 0; i < 4; i++) {
                for (int j = 0; j < 2; j++) {
                    System.out.print("Elemento B[" + i + "][" + j + "]: ");
                    B[i][j] = scanner.nextInt();
                }
            }
            
            // Multiplicação das matrizes
            for (int i = 0; i < 2; i++) {
                for (int j = 0; j < 2; j++) {
                    C[i][j] = 0;
                    for (int k = 0; k < 4; k++) {
                        C[i][j] += A[i][k] * B[k][j];
                    }
                }
            }
            
            System.out.println("\nResultado da Matriz C (2x2):");
            for (int i = 0; i < 2; i++) {
                for (int j = 0; j < 2; j++) {
                    System.out.print(C[i][j] + "\t");
                }
                System.out.println();
            }
        }
    }
}
